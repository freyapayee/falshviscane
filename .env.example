VISCANE_SECRET_KEY=replace-with-a-strong-secret-key

# Shared hosted PostgreSQL for the whole team.
# Replace with your real hosted connection string and give the same value to teammates.
DATABASE_URL=postgresql://shared_user:shared_password@your-db-host:5432/viscane_db

# Optional local Docker fallback values.
LOCAL_POSTGRES_USER=user
LOCAL_POSTGRES_PASSWORD=password
LOCAL_POSTGRES_DB=viscane_db
LOCAL_POSTGRES_PORT=5433

# Optional app port override.
APP_PORT=5000
